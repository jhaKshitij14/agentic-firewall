# Load with:  set -a; source .env; set +a
FIREWALL_POLICY_PATH=app/config/policies.yaml
FIREWALL_DB_PATH=firewall.db
# demo  = in-process simulated MCP server (default, zero setup)
# stdio = spawn a real MCP server over stdio via the official SDK
FIREWALL_UPSTREAM=demo
# Only used when FIREWALL_UPSTREAM=stdio (defaults shown)
# FIREWALL_UPSTREAM_COMMAND=python
# FIREWALL_UPSTREAM_ARGS="-m app.mcp.server"
